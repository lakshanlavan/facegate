# /etc/codeglofix-access.env — CodeGloFix production environment (chmod 600, root-owned)
# Installed by deploy/install_customer_pc.sh. NEVER commit real secrets to git.
#
# This file is read by the systemd service AND by backup_db.sh, so the data-path
# overrides below keep the app and the backup pointed at the same locations.

# ── Secrets (REQUIRED) ────────────────────────────────────────────────────────
# ADMIN_PASSWORD : admin panel login password.
# SESSION_SECRET : 32+ byte hex; generate with
#                  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=__ADMIN_PASSWORD__
SESSION_SECRET=__SESSION_SECRET__

# ── Cookie / TLS ──────────────────────────────────────────────────────────────
# true = only send the admin cookie over HTTPS (production runs behind nginx TLS).
COOKIE_SECURE=true
SESSION_TTL=28800

# ── Production data locations (FHS layout) ────────────────────────────────────
CODEGLOFIX_DB_PATH=/var/lib/codeglofix/gym.db
CODEGLOFIX_ENROLMENTS_DIR=/var/lib/codeglofix/enrolments/shared
CODEGLOFIX_GATE_CONFIG=/var/lib/codeglofix/gate_config.json
CODEGLOFIX_VENV=/opt/codeglofix/venv
CODEGLOFIX_LOG=/var/log/codeglofix/backend.log
BACKUP_DIR=/var/backups/codeglofix

# ── Camera ────────────────────────────────────────────────────────────────────
# 0,1,2…  = webcam index   |   /dev/video0 = device path   |   rtsp://… = IP cam
# A path to a .mp4 file = test/demo mode (loops the file instead of a camera).
# "none" (or any unreachable path) = no-camera placeholder: the backend, live
# view and admin all still start and serve; only the live video shows "no camera".
# The installer's --test-mode-no-hardware flag sets this automatically so a PC
# with no camera/relay/7" display can be fully installed and verified.
VIDEO_SOURCE=0

# ── Door relay controller ─────────────────────────────────────────────────────
# The relay controller connects over USB serial. RELAY_PORT=auto auto-discovers
# the device (PING/PONG). RELAY_BAUDRATE MUST match the controller firmware —
# the production controller firmware runs at 115200. These env values override
# the matching keys in gate_config.json if set.
RELAY_PORT=auto
RELAY_BAUDRATE=115200

# ── Outside live-display MJPEG tuning (lower = less CPU on weak PCs) ───────────
# STREAM_INTERVAL_SECONDS=0.20   # 5 fps
# JPEG_QUALITY=50
